# Supabase Postgres connection string (transaction pooler, port 6543). Get it from
# your Supabase project → "Connect" button → Connection string.
DATABASE_URL=""

# Same project, session pooler (port 5432) — needed only for migrations, since the
# transaction pooler above doesn't support the prepared statements Prisma Migrate uses.
DIRECT_URL=""

# Auth.js secret, used to sign/encrypt session JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Supabase project — from Project Settings → General (URL) and API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
