// Prisma schema for Cohabit
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

/// Paleta curada de 8 colores para identificar a cada usuario en la app
/// (avatares, barra de balance, menciones con nombre) — no es un selector
/// libre, para que cualquier combinación siga encajando con el sistema
/// de diseño base.
enum ProfileColor {
  INDIGO
  GREEN
  ORANGE
  PINK
  TEAL
  LAVENDER
  GOLD
  GRAPHITE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  avatarUrl    String?
  color        ProfileColor @default(INDIGO)
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships         HouseholdMember[]
  addedItems          ShoppingItem[]    @relation("ItemAddedBy")
  purchasedItems      ShoppingItem[]    @relation("ItemPurchasedBy")
  paidExpenses        Expense[]         @relation("ExpensePaidBy")
  expenseSplits       ExpenseSplit[]
  settlementsPaid     Settlement[]      @relation("SettlementFrom")
  settlementsReceived Settlement[]      @relation("SettlementTo")
}

model Household {
  id         String   @id @default(cuid())
  name       String
  iconUrl    String?
  inviteCode String   @unique @default(cuid())
  /// Cuántas personas se espera que vivan aquí — informativo (ej. para
  /// mostrar "2/3 personas"), no un tope técnico que bloquee unirse.
  targetMemberCount Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members       HouseholdMember[]
  shoppingLists ShoppingList[]
  expenses      Expense[]
  categories    Category[]
  budgets       Budget[]
  bills         Bill[]
  settlements   Settlement[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  userId      String
  householdId String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model ShoppingList {
  id          String   @id @default(cuid())
  householdId String
  name        String
  createdAt   DateTime @default(now())

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]
}

model ShoppingItem {
  id            String    @id @default(cuid())
  listId        String
  name          String
  quantity      Int       @default(1)
  isPurchased   Boolean   @default(false)
  addedById     String
  purchasedById String?
  createdAt     DateTime  @default(now())
  purchasedAt   DateTime?

  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy     User         @relation("ItemAddedBy", fields: [addedById], references: [id])
  purchasedBy User?        @relation("ItemPurchasedBy", fields: [purchasedById], references: [id])
}

model Category {
  id          String @id @default(cuid())
  householdId String
  name        String

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  budgets   Budget[]
  bills     Bill[]

  @@unique([householdId, name])
}

model Expense {
  id          String   @id @default(cuid())
  householdId String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  paidById    String
  categoryId  String?
  billId      String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  category  Category?      @relation(fields: [categoryId], references: [id])
  bill      Bill?          @relation(fields: [billId], references: [id])
  splits    ExpenseSplit[]
}

model ExpenseSplit {
  id          String  @id @default(cuid())
  expenseId   String
  userId      String
  shareAmount Decimal @db.Decimal(10, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model Bill {
  id                    String   @id @default(cuid())
  householdId           String
  name                  String
  amount                Decimal  @db.Decimal(10, 2)
  dueDay                Int
  categoryId            String?
  installmentsRemaining Int?
  /// El total original del plan (ej. 12 meses) — separado de
  /// installmentsRemaining para poder mostrar el progreso ("5/12") y para
  /// no perder ese dato cuando algunas mensualidades ya se pagaron antes de
  /// registrar la compra en la app.
  totalInstallments     Int?
  /// Primer mes en que este Bill empieza a generar vencimientos — antes de
  /// este mes, nunca se marca como "vencido" ni "vence pronto".
  startsAt              DateTime @default(now())
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])
  payments  Expense[]
}

/// Un pago que salda deuda registrado fuera de la app (ej. transferencia
/// bancaria) — a diferencia de Expense, no es una compra compartida, así que
/// nunca se reparte con ExpenseSplit; solo resta del balance calculado.
model Settlement {
  id          String   @id @default(cuid())
  householdId String
  fromUserId  String
  toUserId    String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromUser  User      @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser    User      @relation("SettlementTo", fields: [toUserId], references: [id])
}

model Budget {
  id           String  @id @default(cuid())
  householdId  String
  categoryId   String
  monthlyLimit Decimal @db.Decimal(10, 2)
  month        Int
  year         Int

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, month, year])
}
