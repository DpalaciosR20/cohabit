// Prisma schema for Cohabit
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

/// Cómo se reparten los gastos nuevos del hogar.
/// EVEN = parejo (default). MANUAL = % fijo por miembro (HouseholdMember.splitPercent).
/// INCOME = % proporcional al ingreso de cada quien (User.monthlyIncome).
enum SplitMode {
  EVEN
  MANUAL
  INCOME
}

/// Paleta curada de 8 colores para identificar a cada usuario en la app
/// (avatares, barra de balance, menciones con nombre) — no es un selector
/// libre, para que cualquier combinación siga encajando con el sistema
/// de diseño base.
enum ProfileColor {
  INDIGO
  GREEN
  ORANGE
  PINK
  TEAL
  LAVENDER
  GOLD
  GRAPHITE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  avatarUrl    String?
  color        ProfileColor @default(INDIGO)
  /// Ingreso mensual — privado, nunca se expone a otros miembros del hogar.
  /// Se usa para calcular el split proporcional en modo INCOME (solo se ve
  /// el % resultante) y como el lado "ingresos" del balance de gastos
  /// personales.
  monthlyIncome Decimal? @db.Decimal(10, 2)
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships         HouseholdMember[]
  addedItems          ShoppingItem[]    @relation("ItemAddedBy")
  purchasedItems      ShoppingItem[]    @relation("ItemPurchasedBy")
  paidExpenses        Expense[]         @relation("ExpensePaidBy")
  expenseSplits       ExpenseSplit[]
  settlementsPaid     Settlement[]      @relation("SettlementFrom")
  settlementsReceived Settlement[]      @relation("SettlementTo")
  personalExpenses    PersonalExpense[]
  personalBudgets     PersonalBudget[]
  personalBills       PersonalBill[]
}

model Household {
  id         String   @id @default(cuid())
  name       String
  iconUrl    String?
  inviteCode String   @unique @default(cuid())
  /// Cuántas personas se espera que vivan aquí — informativo (ej. para
  /// mostrar "2/3 personas"), no un tope técnico que bloquee unirse.
  targetMemberCount Int?
  /// Ver enum SplitMode. Se resetea a EVEN cuando cambia la membresía y el
  /// modo era MANUAL (los % dejarían de cubrir a los miembros actuales) —
  /// INCOME no necesita ese reset porque se recalcula solo con quien haya
  /// registrado ingreso en cada momento.
  splitMode  SplitMode @default(EVEN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members       HouseholdMember[]
  shoppingLists ShoppingList[]
  expenses      Expense[]
  categories    Category[]
  budgets       Budget[]
  bills         Bill[]
  settlements   Settlement[]
}

model HouseholdMember {
  id          String        @id @default(cuid())
  userId      String
  householdId String
  role        HouseholdRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  /// % de los gastos nuevos que le toca a este miembro. NULL en todos los
  /// miembros = split parejo (default). Si está configurado, siempre debe
  /// sumar 100% entre TODOS los miembros actuales del hogar — se resetea a
  /// NULL para todo el hogar en cuanto cambia la membresía (alguien se une,
  /// sale o es expulsado), para que nunca quede una configuración a medias.
  splitPercent Decimal? @db.Decimal(5, 2)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model ShoppingList {
  id          String   @id @default(cuid())
  householdId String
  name        String
  createdAt   DateTime @default(now())

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]
}

model ShoppingItem {
  id            String    @id @default(cuid())
  listId        String
  name          String
  quantity      Int       @default(1)
  isPurchased   Boolean   @default(false)
  addedById     String
  purchasedById String?
  createdAt     DateTime  @default(now())
  purchasedAt   DateTime?

  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy     User         @relation("ItemAddedBy", fields: [addedById], references: [id])
  purchasedBy User?        @relation("ItemPurchasedBy", fields: [purchasedById], references: [id])
}

model Category {
  id          String @id @default(cuid())
  householdId String
  name        String

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  budgets   Budget[]
  bills     Bill[]

  @@unique([householdId, name])
}

model Expense {
  id          String   @id @default(cuid())
  householdId String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  paidById    String
  categoryId  String?
  billId      String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  category  Category?      @relation(fields: [categoryId], references: [id])
  bill      Bill?          @relation(fields: [billId], references: [id])
  splits    ExpenseSplit[]
}

model ExpenseSplit {
  id          String  @id @default(cuid())
  expenseId   String
  userId      String
  shareAmount Decimal @db.Decimal(10, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model Bill {
  id                    String   @id @default(cuid())
  householdId           String
  name                  String
  amount                Decimal  @db.Decimal(10, 2)
  dueDay                Int
  categoryId            String?
  installmentsRemaining Int?
  /// El total original del plan (ej. 12 meses) — separado de
  /// installmentsRemaining para poder mostrar el progreso ("5/12") y para
  /// no perder ese dato cuando algunas mensualidades ya se pagaron antes de
  /// registrar la compra en la app.
  totalInstallments     Int?
  /// Primer mes en que este Bill empieza a generar vencimientos — antes de
  /// este mes, nunca se marca como "vencido" ni "vence pronto".
  startsAt              DateTime @default(now())
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id])
  payments  Expense[]
}

/// Un pago que salda deuda registrado fuera de la app (ej. transferencia
/// bancaria) — a diferencia de Expense, no es una compra compartida, así que
/// nunca se reparte con ExpenseSplit; solo resta del balance calculado.
model Settlement {
  id          String   @id @default(cuid())
  householdId String
  fromUserId  String
  toUserId    String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromUser  User      @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser    User      @relation("SettlementTo", fields: [toUserId], references: [id])
}

model Budget {
  id           String  @id @default(cuid())
  householdId  String
  categoryId   String
  monthlyLimit Decimal @db.Decimal(10, 2)
  month        Int
  year         Int

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, month, year])
}

/// Un gasto puramente personal — no se reparte con nadie, no pertenece a
/// ningún Household. `category` es el nombre curado (ver EXPENSE_CATEGORIES
/// en el código), guardado como texto libre en vez de una relación a
/// Category porque esa tabla está scoped a un hogar y esto es del usuario.
model PersonalExpense {
  id          String   @id @default(cuid())
  userId      String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  category    String?
  /// Si este gasto viene de marcar un PersonalBill como pagado.
  billId      String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill PersonalBill? @relation(fields: [billId], references: [id])
}

/// Igual que Bill, pero a nivel personal — sin householdId, sin split,
/// nadie más lo ve. Marcar como pagado genera un PersonalExpense.
model PersonalBill {
  id                    String   @id @default(cuid())
  userId                String
  name                  String
  amount                Decimal  @db.Decimal(10, 2)
  dueDay                Int
  category              String?
  installmentsRemaining Int?
  totalInstallments     Int?
  startsAt              DateTime @default(now())
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments PersonalExpense[]
}

/// Límite mensual que el usuario se pone para una categoría de sus gastos
/// personales — un solo valor "vigente" por categoría (no historial mes a
/// mes como el Budget del hogar), comparado siempre contra el mes en curso.
/// Solo un aviso visual (barra de progreso) — no hay infraestructura de
/// notificaciones (email/push) en la app para algo más activo.
model PersonalBudget {
  id           String  @id @default(cuid())
  userId       String
  /// Nombre curado (ver EXPENSE_CATEGORIES) — mismo criterio que
  /// PersonalExpense.category, texto libre en vez de relación a Category.
  category     String
  monthlyLimit Decimal @db.Decimal(10, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}
